{
  "version": 3,
  "reviewedAt": "2026-08-26",
  "global": {
    "singlePublisherPerService": true,
    "requireSafetyQa": true,
    "requireVerifiedRights": true,
    "noAutomaticRetryAfterUnknownExternalState": true,
    "revenueTeacherSignal": "verified-purchase-not-engagement"
  },
  "providers": {
    "buffer": {
      "status": "active",
      "role": "primary-publisher",
      "publishingEnabled": true,
      "allowedServices": ["instagram", "tiktok", "youtube"],
      "credentialSource": "github-actions-secret",
      "notes": "Only autonomous publisher for Instagram, TikTok and YouTube. Use official Buffer API and publication ledger."
    },
    "metricool": {
      "status": "onboarding",
      "role": "analytics-mcp-and-expansion-control-plane",
      "publishingEnabled": false,
      "analyticsConnections": ["instagram", "tiktok", "youtube"],
      "adoptedExpansionServices": ["bluesky", "threads", "pinterest"],
      "deferredExpansionServices": ["facebook-page"],
      "excludedOnFree": ["linkedin", "x"],
      "notes": "Use Free-plan analytics/MCP as the social measurement layer. Existing Buffer services remain analytics-only in Metricool. Bluesky, Threads and Pinterest are adopted expansion surfaces, but automatic publishing remains disabled until each account is connected and the single-publisher safety gate explicitly assigns ownership."
    },
    "vista-social": {
      "status": "deferred",
      "role": "none",
      "publishingEnabled": false,
      "allowedServices": [],
      "reconsiderWhen": [
        "shared-inbox-or-dm-automation-becomes-a-material-bottleneck",
        "team-approval-workflows-are-needed",
        "incremental-value-clearly-exceeds-paid-plan-cost"
      ]
    },
    "publer": {
      "status": "deferred",
      "role": "cold-standby-candidate",
      "publishingEnabled": false,
      "allowedServices": [],
      "reconsiderWhen": [
        "buffer-free-limits-block-required-distribution",
        "publer-api-access-becomes-cost-effective-for-current-scale"
      ]
    }
  }
}
